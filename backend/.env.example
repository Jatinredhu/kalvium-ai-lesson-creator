# Server Configuration
PORT=5000

# Database Configuration (Optional: Connects to MongoDB if available, otherwise falls back to local JSON storage)
MONGODB_URI=mongodb://127.0.0.1:27017/kalvium_lessons

# Optional AI API Keys (Supports Gemini, OpenAI, or Groq)
# If left empty, the built-in pedagogical synthesizer engine runs offline with zero setup!
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
